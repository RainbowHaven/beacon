# Copy values into the Railway **production** app service Variables tab.
# Staging: see .env.staging.example and README.md in this folder.
#
# From Railway Postgres plugin (reference variable):
# DATABASE_URL=${{Postgres.DATABASE_URL}}

BASE_URL=https://beacon.magiconair.net
SECURE_COOKIES=true
WEBAUTHN_RP_ID=beacon.magiconair.net
WEBAUTHN_RP_DISPLAY_NAME=Beacon
WEBAUTHN_RP_ORIGINS=https://beacon.magiconair.net

BOOTSTRAP_ADMIN_EMAIL=rhc@example.com
# Set true only once if you need a fresh bootstrap invite, then set false and redeploy.
BOOTSTRAP_REISSUE=false

# Required by the current binary until identity sealing is removed from the app.
# Any local `make env` values work for a throwaway deploy.
IDENTITY_PUBLIC_KEY_B64=
IDENTITY_KEY_ID=prod-1

# Optional: Railway sets PORT automatically. ADDR overrides if you set it.
# PORT=8080
